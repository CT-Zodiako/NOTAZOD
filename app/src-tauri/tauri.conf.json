{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOTAZOD",
  "version": "0.1.1",
  "identifier": "com.notazod.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NOTAZOD",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/CT-Zodiako/NOTAZOD/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBNTVEODE0MzU0NzQ4MkQKUldRdFNFYzFGTmhWU2s2NDA5eWFvZlNncFE2Mk8vYjRrQnNJUzZyTVlkaE83S1FVbmE2ejE3S28K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
