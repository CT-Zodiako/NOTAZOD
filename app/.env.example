# Name of the SQLite database file NOTAZOD opens through the Tauri SQL plugin.
# Defaults to notazod-dev.db when unset (safe for local development).
# Production releases MUST explicitly set VITE_NOTAZOD_DB_NAME=notazod.db
# so the packaged app never touches a development database file.
VITE_NOTAZOD_DB_NAME=notazod-dev.db
